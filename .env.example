# Copy to .env (or paste these into Portainer's stack environment panel).
# Only DASHBOARD_PASSWORD is required.

# Dashboard login
DASHBOARD_PASSWORD=change-me
# RESTRUO_USERNAME=admin

# Branding
# RESTRUO_TITLE=Restruo

# Host port (container always listens on 8080)
# RESTRUO_PORT=8080

# Tags treated as rolling for update checks. Add others if you run projects
# that ship on them, e.g. immich's :release.
# RESTRUO_FLOATING_TAGS=latest,release

# How often an open dashboard re-reads container state, in seconds. 0 disables.
# RESTRUO_REFRESH_SECONDS=180

# Email notifications (outbound only — nothing needs to be exposed).
# For Gmail, Outlook, Yahoo, iCloud or Fastmail these two lines are all you need:
# the server, port, sender and recipient are inferred from the address.
# Gmail wants an App Password, not your account password.
# RESTRUO_SMTP_USER=you@gmail.com
# RESTRUO_SMTP_PASSWORD=your-app-password
#
# Only for other providers / your own relay:
# RESTRUO_SMTP_HOST=smtp.example.com
# RESTRUO_SMTP_PORT=587
# RESTRUO_SMTP_SECURITY=starttls
# RESTRUO_EMAIL_TO=someone-else@example.com

# Logins for private registries, so their images can be update-checked.
# RESTRUO_REGISTRY_AUTH=ghcr.io=user:ghp_token
